# Generated images
*.jpg
*.jpeg
*.png
*.tif
*.tiff

# ...except the pre-computed frame libraries, which ARE a deliverable
# (rotation sweeps replayed by the camera server; see loop_sim/library/).
!frame_library/**/*.png
!frame_library/**/*.jpg
!frame_library/**/manifest.json

# Coarse PREVIEW libraries the camera server builds on demand when you switch
# it to a scene that has none.  Disposable build output, NOT a deliverable --
# the opposite of frame_library/ above.  Their images are already ignored by
# the *.png / *.jpg rules, but manifest.json matches no rule at all, so without
# this line every preview manifest would be tracked while its frames were not.
# Deliberately a file pattern rather than a `frame_library_preview/` directory
# rule: git does not descend into an excluded directory, so a directory rule
# would make any later `!` re-include beneath it silently impossible.
frame_library_preview/**/manifest.json

# Generated scene files (built by the pipeline)
scene.yaml
loop.yaml

# Backup files
*.04-12-26*
*~

# Claude internal state
.claude/

# Benchmark output (bench_frame.py)
bench_results/

# Misc
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
dist/
build/
notes.com
peak.txt
this.yaml
old/

.omc/
.slot-machine/
