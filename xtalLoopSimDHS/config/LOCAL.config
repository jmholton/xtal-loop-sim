# xtalLoopSimDHS configuration for the LOCAL dcss sandbox (YAML).
# Notes on each key are at the bottom. Device table: README.md "Devices".
dcss:
    host: localhost                 # the local dcss test rig; never a beamline host
    port: 14242                     # dcss hardware port

xtal_loop_sim:
    dhs_name: xtalLoopSimDHS        # must match the type-3 hardware-host row in the dcss database
    camera_server: http://localhost:8080    # the loop-sim camera server (real mode only)
    http_timeout_s: 3.0             # per-request connect+read timeout
    poll_interval_s: 0.1            # between position reports while a move runs
    min_move_s: 0.05                # floor on a move's duration
    video_shutter: video_trigger    # the shutter that pushes to the camera server

    # name: the DCSS motor. sim_key: the camera server's pose key. scale, speed,
    # accel, backlash, the limits and the flags are the beamline database's own
    # values (dcsconfig/data/BL-831.dat), reported verbatim in
    # htos_configure_device. position seeds the pose until the camera server is
    # read; the simulator's scene starts at its origin.
    motors:
        gonio_phi:
            sim_key: rotx
            units: deg
            scale: 8385             # steps/deg
            speed: 9000000          # steps/s
            accel: 20000
            upper: 360
            lower: 360
            circle: 360             # dcss circle mode: report wrapped to [0, 360)
            position: 0
        absolute_phi:
            sim_key: rotx           # the same spindle, never wrapped
            units: deg
            scale: 8385
            speed: 3000000
            accel: 20000
            circle: 0
            position: 0
        sample_x:
            sim_key: tx
            units: mm
            scale: 16968            # steps/mm
            speed: 5000
            accel: 100
            sign: 1
            position: 0
        sample_y:
            sim_key: ty
            units: mm
            scale: 16968
            speed: 5000
            accel: 100
            sign: 1
            position: 0
        sample_z:
            sim_key: tz
            units: mm
            scale: 16968
            speed: 5000
            accel: 100
            sign: 1
            position: 0

    shutters:
        shutter: closed             # state only
        detector_trigger: closed    # state only
        video_trigger: closed       # open also POSTs /video-trigger to the camera server

# Notes
#
# dhs_name: dcss rejects a name that is not a hardware-host row in its database,
#   and a second connection under the same name. The sandbox seed that adds the
#   row and re-points the devices is sandbox/LOCAL_loopsim.txt.
#
# dcss.host: the DHS refuses to start when this names the production beamline
#   unless it was started as SIM831. The production database belongs to pmac2.
#
# camera_server: real mode only; pretend mode contacts nothing. The DHS needs
#   GET /status, POST /move?...&duration=, POST /motor and POST /video-trigger
#   (README "What the camera server must provide").
#
# poll_interval_s: how often a running move is sampled and, when the position
#   has changed, reported as htos_update_motor_position. A move shorter than
#   this completes with no updates at all, which is correct: nothing changed
#   that dcss had not already been told.
#
# min_move_s: a zero-length move still goes through the whole
#   started/completed stream, so dcss is never left waiting on a completion.
#
# motors: two motors may share one sim_key. gonio_phi and absolute_phi are the
#   same spindle, so a move on either answers `moving` on the other.
#
# sign: +1 when the beamline axis and the scene axis point the same way, -1 when
#   they oppose. Flip it here rather than in the scene, which belongs to loop-sim.
#
# circle: 360 wraps the reported position into [0, 360) while the pose keeps
#   counting, so absolute_phi reads the turn count the spindle has actually made.
#
# camera_zoom is deliberately absent: it is a dcss-internal pseudo-motor and
#   nothing registers it to a DHS.
