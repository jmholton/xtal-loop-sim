# xtalLoopSimDHS configuration for a local, offline dcss (YAML).
# Notes on each key are at the bottom. Device table: README.md "Devices".
dcss:
    host: localhost                 # the local dcss test rig; never a beamline host
    port: 14242                     # dcss hardware port

xtal_loop_sim:
    dhs_name: xtalLoopSimDHS        # must match the type-3 hardware-host row in the dcss database
    camera_server: http://localhost:8081    # the loop-sim camera server (real mode only)
    http_timeout_s: 3.0             # per-request connect+read timeout
    poll_interval_s: 0.1            # between position reports while a move runs
    min_move_s: 0.05                # floor on a move's duration
    video_shutter: video_trigger    # the shutter that pushes to the camera server

    # name: the DCSS motor. sim_key: the camera server's pose key. scale, speed,
    # accel, backlash, the limits and the flags are the beamline database's own
    # values (dcsconfig/data/BL-831.dat), reported verbatim in
    # htos_configure_device. position seeds the pose until the camera server is
    # read; the simulator's scene starts at its origin.
    motors:
        gonio_phi:
            sim_key: rotx
            units: deg
            scale: 8385             # steps/deg
            speed: 9000000          # steps/s
            accel: 20000
            upper: 360
            lower: 360
            circle: 360             # dcss circle mode: report wrapped to [0, 360)
            position: 0
        absolute_phi:
            sim_key: rotx           # the same spindle, never wrapped
            units: deg
            scale: 8385
            speed: 3000000
            accel: 20000
            circle: 0
            position: 0
        sample_x:
            sim_key: tx
            units: mm
            scale: 16968            # steps/mm
            speed: 5000
            accel: 100
            sign: 1
            position: 0
        sample_y:
            sim_key: ty
            units: mm
            scale: 16968
            speed: 5000
            accel: 100
            sign: 1
            position: 0
        sample_z:
            sim_key: tz
            units: mm
            scale: 16968
            speed: 5000
            accel: 100
            sign: 1
            position: 0

    shutters:
        shutter: closed             # state only
        detector_trigger: closed    # state only
        video_trigger: closed       # every state change also POSTs /video-trigger to the camera server

# Notes
#
# dhs_name: must match the type-3 hardware-host row in the dcss database
#   (README "dcss integration"); see README "Notes" for what dcss enforces on it.
#
# dcss.host: refused at startup unless beamline is SIM831; the production
#   database belongs to pmac2 (README's opening paragraph).
#
# camera_server: real mode only; pretend mode contacts nothing. The DHS needs
#   GET /status, POST /move?...&duration=, POST /motor and POST /video-trigger
#   (README "What the camera server must provide").
#
# poll_interval_s: how often a running move is sampled and reported as
#   htos_update_motor_position; see README "A move" for what a move shorter
#   than this does.
#
# min_move_s: a zero-length move still goes through the whole
#   started/completed stream, so dcss is never left waiting on a completion.
#
# motors: two motors may share one sim_key; see README "Devices" for
#   gonio_phi/absolute_phi, the same spindle.
#
# sign: +1 when the beamline axis and the scene axis point the same way, -1 when
#   they oppose. Flip it here rather than in the scene, which belongs to loop-sim.
#
# circle: 360 wraps the reported position into [0, 360); see README "Notes"
#   for how a circle axis is driven and why absolute_phi never wraps.
#
# camera_zoom is deliberately absent (README "Devices").
