# xtalLoopSimDHS configuration for a SIM831 dcss instance (YAML).
# The same device table as config/LOCAL.config; only the dcss endpoint and the
# camera-server address differ. Key notes are in config/LOCAL.config.
dcss:
    host: localhost                 # the SIM831 dcss; the host it runs on, not the beamline
    port: 15242                     # SIM831's hardware port

xtal_loop_sim:
    dhs_name: xtalLoopSimDHS
    camera_server: http://localhost:8080
    http_timeout_s: 3.0
    poll_interval_s: 0.1
    min_move_s: 0.05
    video_shutter: video_trigger

    motors:
        gonio_phi:
            sim_key: rotx
            units: deg
            scale: 8385
            speed: 9000000
            accel: 20000
            upper: 360
            lower: 360
            circle: 360
            position: 0
        absolute_phi:
            sim_key: rotx
            units: deg
            scale: 8385
            speed: 3000000
            accel: 20000
            circle: 0
            position: 0
        sample_x:
            sim_key: tx
            units: mm
            scale: 16968
            speed: 5000
            accel: 100
            sign: 1
            position: 0
        sample_y:
            sim_key: ty
            units: mm
            scale: 16968
            speed: 5000
            accel: 100
            sign: 1
            position: 0
        sample_z:
            sim_key: tz
            units: mm
            scale: 16968
            speed: 5000
            accel: 100
            sign: 1
            position: 0

    shutters:
        shutter: closed
        detector_trigger: closed
        video_trigger: closed

# SIM831 is the one beamline name allowed to point at a dcss host whose name
# contains bl831.als.lbl.gov, because the SIM831 instance runs there. Every
# other name is refused at startup (exit 2).
